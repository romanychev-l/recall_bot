TOKEN=your_bot_token_here

# Path to the SQLite file. Locally a relative path is fine; in Docker this
# defaults to /data/recall_bot.db (a mounted volume) via the Dockerfile.
DB_PATH=recall_bot.db

# Optional: full SQLAlchemy URL, overrides DB_PATH. Use to move to another
# backend without code changes, e.g. postgresql+asyncpg://user:pass@host/db
# DATABASE_URL=

# Seeded into an empty database on first start.
DICTIONARY_CSV=data/dictionary.csv

LOG_LEVEL=INFO
# Timezone for the reminder scheduler.
SCHEDULER_TZ=UTC
